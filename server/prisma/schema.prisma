generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique @db.VarChar(256)
  password_hash String  @db.VarChar(256)
  role          String? @default("admin") @db.VarChar(50)

  @@map("users")
}

// -----------------------------------------------------
// SYNAPSE ACADEMIC ARCHITECTURE
// -----------------------------------------------------

model Regulation {
  id        Int      @id @default(autoincrement())
  name      String   @unique // e.g., "R22"
  createdAt DateTime @default(now())
  
  // A regulation has many branches
  branches  Branch[]
}

model Branch {
  id           Int      @id @default(autoincrement())
  name         String   // e.g., "B.Tech CSE"
  
  // Foreign Key linking back to Regulation
  regulationId Int
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  
  // A branch has many subjects
  subjects     Subject[]
}

model Subject {
  id           Int      @id @default(autoincrement())
  name         String   // e.g., "Mathematics-I"
  year         Int      // e.g., 1, 2, 3, 4
  semester     Int?     // Optional: in case you need to split years into semesters later
  
  // Foreign Key linking back to Branch
  branchId     Int
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  // A subject has many grading components
  components   SubjectComponent[]
}

model SubjectComponent {
  id           Int      @id @default(autoincrement())
  name         String   // e.g., "Theory", "Lab", "Assignments"
  
  // Foreign Key linking back to Subject
  subjectId    Int
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}