generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  role          String   @default("student")
}

model Regulation {
  id       Int      @id @default(autoincrement())
  name     String
  branches Branch[]
}

model Branch {
  id           Int        @id @default(autoincrement())
  name         String
  regulationId Int
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  subjects     Subject[]
}

model Subject {
  id         Int                @id @default(autoincrement())
  name       String
  year       Int
  semester   Int
  branchId   Int
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  components SubjectComponent[]
  resources  Resource[]         
}

model SubjectComponent {
  id        Int      @id @default(autoincrement())
  type      String   
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  modules   Module[] 
}

model Module {
  id          Int      @id @default(autoincrement())
  name        String   // e.g., "Unit", "Experiment"
  moduleNo    Int      // The exact integer for perfect sorting
  componentId Int
  component   SubjectComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  
  resources   Resource[] 
}

model Resource {
  id        Int      @id @default(autoincrement())
  fileName  String   
  fileUrl   String   
  
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  modules   Module[] 
}